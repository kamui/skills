{
  "$id": "bench/schema/harness.schema.json",
  "title": "harness/<cli>.json",
  "description": "Observed built-in reviewer prompts or presets per CLI version, keyed by hash, so an attempt can be matched to a known variant and an unknown one is noticed.",
  "type": "object",
  "required": ["schema_version", "description", "versions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["observed_on"],
        "additionalProperties": false,
        "properties": {
          "observed_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["header", "selected_by", "output_contract", "body_sha256", "body_bytes"],
              "additionalProperties": false,
              "properties": {
                "header": {"type": "string"},
                "selected_by": {"type": "string"},
                "output_contract": {"type": "string"},
                "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "body_bytes": {"type": "integer", "minimum": 1}
              }
            }
          },
          "default_model": {"type": "string"},
          "default_reasoning_effort": {"type": "string"},
          "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rubric_bytes": {"type": "integer", "minimum": 1},
          "rubric_marker": {"type": "string"},
          "output_contract": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
