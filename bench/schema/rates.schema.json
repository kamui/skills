{
  "$id": "bench/schema/rates.schema.json",
  "title": "rates.json",
  "description": "Dated price evidence per model. A run manifest copies the entries it used; results carry both contemporaneous and common-rate costs.",
  "type": "object",
  "required": ["schema_version", "rates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "as_of", "input", "output", "cache_read", "cache_write_5m", "cache_write_1h", "source", "billing"],
        "additionalProperties": false,
        "properties": {
          "model": {"type": "string"},
          "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "input": {"type": "number", "minimum": 0},
          "output": {"type": "number", "minimum": 0},
          "cache_read": {"type": "number", "minimum": 0},
          "cache_write_5m": {"type": "number", "minimum": 0},
          "cache_write_1h": {"type": "number", "minimum": 0},
          "source": {"type": "string"},
          "billing": {"type": "string"}
        }
      }
    }
  }
}
